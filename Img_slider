<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Image Slider</title>
    <style>
        img{
            width: 100%; height: auto;
        }
    </style>
</head>
<body>
    <h2>Image Slider</h2>
    <img id="image" src="SampleImages/image.png" alt="">
    <br><br>
    <button onclick="previous()">Previous</button>
    <button onclick="next()">Next</button>
    <script>
        let images = ["SampleImages/image1.png", "SampleImages/image2.png", "SampleImages/image3.png"];
        let i = 0;
        function next(){
            i++;
            if(i==images.length){
                i = 0;
            }

            document.getElementById("image").src = images[i];
        }
        function previous(){
            i--;
            if(i<0){
                i = images.length-1;
            }
            document.getElementById("image").src = images[i];
        }
        setInterval(next, 3000)
    </script>
</body>
</html>
