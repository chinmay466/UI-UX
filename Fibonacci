<html>
<body>

<h2>Fibonacci Series</h2>

<input type="number" id="num" placeholder="Enter a number">
<button onclick="fib()">Generate</button>

<p id="result"></p>

<script>
function fib() {
    let n = Number(document.getElementById("num").value);
    let a = 0, b = 1, s = "";

    for (let i = 1; i <= n; i++) {
        s = s + a + " ";
        let c = a + b;
        a = b;
        b = c;
    }

    document.getElementById("result").innerHTML = s;
}
</script>

</body>
</html>
